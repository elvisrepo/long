<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="longevity_auth_tokens.xml" />
        <exclude domain="sharedpref" path="longevity_weight_sync_cursors.xml" />
        <exclude domain="sharedpref" path="longevity_health_connect_sync_cursors_fitbit_v2.xml" />
        <exclude domain="sharedpref" path="longevity_health_connect_sync_cursors_activity_v3.xml" />
        <exclude domain="sharedpref" path="longevity_health_connect_sync_cursors_activity_v4.xml" />
        <exclude domain="sharedpref" path="longevity_health_connect_sync_cursors_vitals_v5.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="longevity_auth_tokens.xml" />
        <exclude domain="sharedpref" path="longevity_weight_sync_cursors.xml" />
        <exclude domain="sharedpref" path="longevity_health_connect_sync_cursors_fitbit_v2.xml" />
        <exclude domain="sharedpref" path="longevity_health_connect_sync_cursors_activity_v3.xml" />
        <exclude domain="sharedpref" path="longevity_health_connect_sync_cursors_activity_v4.xml" />
        <exclude domain="sharedpref" path="longevity_health_connect_sync_cursors_vitals_v5.xml" />
    </device-transfer>
</data-extraction-rules>
