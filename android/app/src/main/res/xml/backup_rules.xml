<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Ciphertext is useless after restore because Android Keystore keys never leave the device. -->
    <exclude domain="sharedpref" path="longevity_auth_tokens.xml" />
    <!-- A restored device cursor could skip Health Connect history on a different phone. -->
    <exclude domain="sharedpref" path="longevity_weight_sync_cursors.xml" />
</full-backup-content>
