[Unit]
Description=Verify the newest SyncVitals staging PostgreSQL backup
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/syncvitals/deployment/scripts/staging_db_restore_check.py
UMask=0077
TimeoutStartSec=15min

